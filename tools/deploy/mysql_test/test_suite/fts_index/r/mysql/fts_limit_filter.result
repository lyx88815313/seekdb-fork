drop database if exists fts;
create database fts;
use fts;
create table t_limit_filter(
id int primary key,
title varchar(128),
content varchar(2048),
fulltext index i1(title, content) with parser ik);
insert into t_limit_filter values
(1,'数据库性能优化实践','全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例'),
(2,'全文索引分词器热路径分析','ik 分词需要频繁查词典和判断停用词，CPU 开销集中在分词热路径'),
(3,'OceanBase 稳定性的工程经验','OceanBase 是一款非常稳定的数据库，支持多种内置分词器'),
(4,'倒排索引与检索系统设计','倒排索引是全文检索的核心数据结构，分词质量直接影响召回率'),
(5,'中文分词 ik 词典加载机制','全文索引需要高效的分词器，分词器的词典加载是关键路径'),
(6,'搜索引擎召回率调优笔记','全文检索系统需要平衡召回率和查询延迟'),
(7,'分布式存储 compaction 策略','存储层的归并策略影响索引构建速度'),
(8,'SQL 执行计划与索引选择','全文索引的查询计划依赖代价模型');
select count(*) from (select id from t_limit_filter where match(title, content) against('全文索引 分词器') limit 20) t;
count(*)
5
select count(*) from (select id from t_limit_filter where match(title, content) against('全文索引 分词器') limit 4) t;
count(*)
4
select count(*) from (select id from t_limit_filter where match(title, content) against('全文索引 分词器') limit 2) t;
count(*)
2
select count(*) from (select id from t_limit_filter where match(title, content) against('全文索引 分词器') limit 1) t;
count(*)
1
select count(*) from (select id from t_limit_filter where match(title, content) against('全文索引 分词器') limit 3) t;
count(*)
3
select id from t_limit_filter where match(title, content) against('全文索引 分词器') limit 3;
id
1
2
3
select id, match(title, content) against('全文索引 分词器') as score
from t_limit_filter where match(title, content) against('全文索引 分词器') limit 2;
id	score
5	0.46896840928152084
1	0.36544850498338877
select id, match(title, content) against('全文索引 分词器') as score
from t_limit_filter where match(title, content) against('全文索引 分词器')
order by score desc, id limit 3;
id	score
5	0.46896840928152084
1	0.36544850498338877
2	0.34482758620689663
