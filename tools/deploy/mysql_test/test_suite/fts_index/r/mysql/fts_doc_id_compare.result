drop database if exists fts;
create database fts;
use fts;
set ob_query_timeout = 10000000000;
create table t (
id int primary key,
title varchar(512),
body text
);
insert into t values (1, 'search engine', 'full text search engine');
insert into t values (2, 'database index', 'inverted index for database');
insert into t values (3, 'search database', 'search and database together');
insert into t values (4, 'search', 'only search here');
insert into t values (5, 'database', 'only database here');
insert into t values (6, 'nothing', 'nothing to see');
result_format: 4
alter table t add fulltext index ft_all(title, body) with parser beng;

select id from t where match(title, body) against('search database') order by id;
+----+
| id |
+----+
|  1 |
|  2 |
|  3 |
|  4 |
|  5 |
+----+
select id from t where match(title, body) against('search database') order by id;
+----+
| id |
+----+
|  1 |
|  2 |
|  3 |
|  4 |
|  5 |
+----+
select count(*) from t where match(title, body) against('search database');
+----------+
| count(*) |
+----------+
|        5 |
+----------+
