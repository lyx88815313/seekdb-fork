# owner: seekdb
# owner group: storage
# description: verify that the process wide shared fulltext dictionary keeps the
#              tokenize result stable and independent of the parser that used it

--disable_warnings
drop database if exists fts;
create database fts;
use fts;
set ob_query_timeout = 10000000000;

create table t (id int primary key, title varchar(512), fulltext index ft_title(title) with parser ik);
insert into t values (1, '全文索引的分词器热路径优化');
--enable_warnings

--result_format 4

# the same text must always produce the same tokens, no matter how often the
# tokenizer is invoked and no matter which parser touched the shared dictionary
select tokenize('全文索引的分词器热路径优化', 'ik');
select tokenize('全文索引的分词器热路径优化', 'ik');
select tokenize('The quick brown fox jumps over the lazy dog', 'beng');
select tokenize('全文索引的分词器热路径优化', 'ik');
select tokenize('The quick brown fox jumps over the lazy dog', 'beng');

# the ik and the beng parser must not share their dictionaries
select tokenize('database 稳定 index', 'ik');
select tokenize('database 稳定 index', 'beng');

# words that are located in different ranges of the dictionary
select tokenize('一二三四五六七八九十个', 'ik');
select tokenize('天地玄黄宇宙洪荒', 'ik');
select tokenize('abcdefghijklmnopqrstuvwxyz', 'ik');
select tokenize('ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'beng');

# the tokenizer must keep working after a fulltext index build created the
# shared dictionary
alter table t add fulltext index ft_title2(title) with parser ik;
select tokenize('全文索引的分词器热路径优化', 'ik');
select tokenize('全文索引的分词器热路径优化', 'ik');
select id from t where match(title) against('全文索引');
select id from t where match(title) against('全文索引');

--error ER_INVALID_JSON_TEXT_IN_PARAM
select tokenize('全文索引', 'ik', 'not a json');
--error ER_INVALID_JSON_TEXT_IN_PARAM
select tokenize('全文索引', 'ik', 'not a json');
select tokenize('全文索引', 'ik');
